server {
    listen 443 ssl default_server;
    server_name licariri;

    ssl_certificate /etc/letsencrypt/live/subdomeniudnsdinamic.go.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/subdomeniudnsdinamic.go.ro/privkey.pem;

    server_tokens off;

    add_header Upgrade $http_upgrade;
    add_header Connection "upgrade";
    add_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Host $host;
    proxy_http_version 1.1;

    add_header Content-Security-Policy "default-src https: data: 'unsafe-inline' 'unsafe-eval'" always;
    add_header Referrer-Policy "no-referrer";
    add_header Strict-Transport-Security max-age=31536000;
    add_header X-Content-Type-Options "nosniff";

    add_header Pragma public;
    add_header Cache-Control "public";

    location ~* \.(?:png|jpe?g|webp|css)$ {
        expires 28d;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }

    if ($request_method ~ ^(OPTIONS)$ )
    {
        return 403;
    }
}

server {
    listen 80;
    server_name licariri;
    return 301 https://$host$request_uri;
}
