<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Editează articol</title>
    <%- include("meta"); %>
    <link rel="stylesheet" type="text/css" href="/css/admin.css">
</head>

<body id="edit-article-page">
    <div id="editing-stages">
        <button type="button" id="button-edit-content">Conținut</button>
        <button id="button-edit-dtp">Tehnoredactare</button>
        <button id="button-preview">Previzualizare</button>
    </div>
    <form id="inputform" action="/admin/articles/<%= defaults.id %>" method="post" autocomplete="off" enctype="multipart/form-data">
        <div id="edit-article-content">
            <div id="left">
                <h1>Editează articol</h1>
                <label>Titlu:</label>
                <input required type="text" name="article.title" value="<%= defaults.title %>">

                <label>Subtitlu:</label>
                <input type="text" name="article.subtitle" value="<%= defaults.subtitle %>">

                <label>Limba articolului:</label>
                <select required name="article.language">
                    <option value="ro">Română</option>
                    <option value="en">Engleză</option>
                    <option value="de">Germană</option>
                    <option value="fr">Franceză</option>
                </select>

                <div class="input-multiple">
                    <label>Autori:</label>
                    <div id="input-authors"></div>
                    <button class="add-button" type="button" id="authors-add-button">Adaugă</button>
                </div>

                <div class="input-multiple">
                    <label>Tag-uri:</label>
                    <div id="input-tags"></div>
                    <button class="add-button" type="button" id="tags-add-button">Adaugă</button>
                </div>

                <label>Redactor(i):</label>
                <input type="text" name="article.credits.editorial" value="<%= defaults.credits.editorial.join(', ') %>">

                <label>Tehnoredactor(i):</label>
                <input type="text" name="article.credits.dtp" value="<%= defaults.credits.dtp.join(', ') %>">

                <label>Realizator(i) grafică/thumbnail:</label>
                <input type="text" name="article.credits.thumbnail" value="<%= defaults.credits.thumbnail.join(', ') %>">
            </div>
            <div id="right">
                <textarea required name="contents"><%= defaults.content %></textarea>
            </div>
        </div>
        <div id="edit-article-dtp">
            <div id="preview-minified-thumbnail" class="article-thumbnail no-select" style="width: 300px; position: absolute; right: 100px; top: 300px; transform: translateY(-50%);">
            </div>

            <label>Thumbnail:</label>
            <input type="file" accept="image/*" name="thumbnail">
            <button type="button" id="reset-thumbnail-button">RESETARE</button>

            <label>Ascunde titlul din thumbnail:</label>
            <input type="checkbox" name="style.hideTitleInThumbnail"
                <% if (defaults.style.hideTitleInThumbnail) { %>
                checked
                <% } %>>

            <label>Fontul titlului:</label>
            <select name="style.title.font">
                <option value="Baskervville">Baskervville</option>
                <option value="Kameron" <% if (defaults.style.title.font == "Kameron") { %>selected<% } %>>Kameron</option>
            </select>

            <label>Mărimea fontului titlului din thumbnail:</label>
            <input name="style.title.fontsizeThumbnail"
                value="<%= defaults.style.title.fontsizeThumbnail %>"
                type="range" min="1.5" max="2.5" step="0.1" >

            <label>Mărimea fontului titlului din articol:</label>
            <input name="style.title.fontsizeArticle"
                value="<%= defaults.style.title.fontsizeArticle %>"
                type="range" min="2" max="5" step="0.1" >

            <label>Grosimea fontului titlului:</label>
            <input name="style.title.fontweight"
                value="<%= defaults.style.title.fontweight %>"
                type="range" min="400" max="800" step="50">

            <!--TITLE FILL STYLE == <select>-->
            <label>Titlul contrastează cu fundalul (ignoră culoarea):</label>
            <input type="checkbox" name="style.title.fillStyle"
                <% if (defaults.style.title.fillStyle) { %>
                checked
                <% } %>>

            <label>Culoarea titlului:</label>
            <input name="style.title.color"
                value="<%= defaults.style.title.color %>"
                type="color">

            <label>Poziția titlului în articol:</label>
            <select name="style.title.position">
                <option value="thumbnail">Pe thumbnail</option>
                <option value="article" <% if (defaults.style.title.position == "article") { %>selected<% } %>>Sub thumbnail</option>

            </select>

            <label>Fontul subtitlului:</label>
            <select name="style.subtitle.font">
                <option value="Baskervville">Baskervville</option>
                <option value="Kameron" <% if (defaults.style.subtitle.font == "Kameron") { %>selected<% } %>>Kameron</option>
            </select>

            <label>Mărimea fontului subtitlului din articol:</label>
            <input name="style.subtitle.fontsize"
                value="<%= defaults.style.subtitle.fontsize %>"
                type="range" min="1" max="2" step="0.1" >

            <label>Grosimea fontului subtitlului:</label>
            <input name="style.subtitle.fontweight"
                value="<%= defaults.style.subtitle.fontweight %>"
                type="range" min="400" max="800" step="50">

            <label>Culoarea subtitlului:</label>
            <input name="style.subtitle.color"
                value="<%= defaults.style.subtitle.color %>"
                type="color">

            <label>Poziția subtitlului în articol:</label>
            <select name="style.subtitle.position">
                <option value="thumbnail">Pe thumbnail</option>
                <option value="article" <% if (defaults.style.subtitle.position == "article") { %>selected<% } %>>Sub thumbnail</option>
            </select>

            <label>Stilul primei litere din text:</label>
            <select name="style.article.firstLetter">
                <option value="default">Fără stil</option>
                <option value="dropcap" <% if (defaults.style.article.firstLetter == "dropcap") { %>selected<% } %>>Dropcap cu border</option>
            </select>
        </div>
        <input id="article-submit-button" type="submit" value="Trimite">
    </form>
    <div id="article-page">
    </div>
</body>

<script type="text/javascript">
    const authorsAddButton = document.getElementById("authors-add-button");
    const tagsAddButton = document.getElementById("tags-add-button");

    // `type` may be either "author" or "tag"
    const addField = (type = "", value = "") => {
        const fieldsContainer = document.getElementById("input-" + type + "s");
        let field = document.createElement("div");
        field.classList.add(type);

        let fieldInput = document.createElement("input");
        fieldInput.name = "article" + "." + type + "s" + "." + fieldsContainer.childElementCount;
        if (type == "image") {
            fieldInput.type = "file";
            fieldInput.accept = "image/*";
        } else {
            fieldInput.type = "text";
        }
        fieldInput.value = value;

        let fieldDeleteButton = document.createElement("button");
        fieldDeleteButton.type = "button";
        fieldDeleteButton.classList.add("delete-button");
        fieldDeleteButton.classList.add("fa");
        fieldDeleteButton.classList.add("fa-trash-o");
        fieldDeleteButton.addEventListener("click", () => {
            fieldsContainer.removeChild(field)
        })

        field.appendChild(fieldInput);
        field.appendChild(fieldDeleteButton);
        fieldsContainer.appendChild(field);
    }

    <% for (author of defaults.authors) { %>
        addField("author", "<%= author %>");
    <% } %>
    <% for (tag of defaults.tags) { %>
        addField("tag", "<%= tag %>");
    <% } %>

    authorsAddButton.addEventListener("click", () => addField("author", ""));
    tagsAddButton.addEventListener("click", () => addField("tag", ""));
</script>

<script type="text/javascript">
    const contentPage = document.getElementById("edit-article-content");
    const dtpPage = document.getElementById("edit-article-dtp");
    const previewPage = document.getElementById("article-page");
    const articleInputForm = document.getElementById("inputform");

    const previewMinifiedThumbnail = document.getElementById("preview-minified-thumbnail");

    const htmlFormToNestedJSON = (form) => {
        const formData = new FormData(form);
        const nestedJSON = {};

        for (let [field, value] of formData) {
            const keys = field.split(".");
            let current = nestedJSON;
            let parentKey = undefined;
            keys.forEach((key, nestingIndex) => {
                if (key == "thumbnail" && parentKey != "credits" && value.size == 0) {
                    value = undefined;
                }
                if (nestingIndex == keys.length - 1) {
                    if (Array.isArray(current)) {
                        current.push(value);
                    } else if (parentKey == "credits") {
                        if (value) {
                            current[key] = value.split(",").map((x) => x.trim());
                        } else {
                            current[key] = [];
                        }
                    } else {
                        current[key] = value;
                    }
                } else {
                    if (!current[key]) { // prevent overwrite
                        if (key == "authors" || key == "tags") {
                            current[key] = [];
                        } else {
                            current[key] = {};
                        }
                    }
                    current = current[key];
                }
                parentKey = key;
            })
        }
        return nestedJSON;
    }

    const showContentPage = () => {
        contentPage.style.display = "grid";
        dtpPage.style.display = "none";
        previewPage.style.display = "none";
    }

    const showDTPPage = () => {
        contentPage.style.display = "none";
        dtpPage.style.display = "grid";
        previewPage.style.display = "none";
    }

    const showPreviewPage = () => {
        let formJSON = htmlFormToNestedJSON(articleInputForm);
        formJSON.originalID = "<%= defaults.id %>";
        formJSON.originalDate = "<%= defaults.date %>";
        fetch("/admin/articles/article-preview", {
            method: "POST",
            headers: {
                'Content-Type': 'application/json',
                'Accepts': 'text/html'
            },
            body: JSON.stringify(formJSON)
        })
            .then((response) => {
                return response.text();
            })
            .then((html) => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, "text/html");
                previewPage.innerHTML = doc.body.innerHTML;
            });

        contentPage.style.display = "none";
        dtpPage.style.display = "none";
        previewPage.style.display = "grid";
    }

    document.getElementById("button-edit-content").addEventListener("click", showContentPage);
    document.getElementById("button-edit-dtp").addEventListener("click", showDTPPage);
    document.getElementById("button-preview").addEventListener("click", showPreviewPage);

    window.addEventListener("beforeunload", (event) => {
        event.preventDefault();
        event.returnValue = true;
    });

    articleInputForm.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        let formJSON = htmlFormToNestedJSON(articleInputForm);
        fetch("/admin/articles/<%= defaults.id %>", {
            method: "POST",
            headers: {
                'Content-Type': 'application/json',
                'Accepts': 'text/html'
            },
            body: JSON.stringify(formJSON)
        });
    })
</script>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>

</html>
