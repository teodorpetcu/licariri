<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Autentificare</title>
<%- include("meta"); _%>
    <link rel="stylesheet" href="/css/login.css?v0.1.1">
    <script type="text/javascript" src="/js/main-nav.js" defer></script>
</head>

<body id="login-page">
<%- include("nav"); _%>
    <div id="login-input-credentials">
        <h1>Autentificare</h1>
        <form action="/login" method="post" autocomplete="off">
            <label>Nume utilizator:</label>
            <input required type="text" id="username" name="username">

            <label>Parolă:</label>
            <input required type="password" id="password" name="password">

            <input id="remember_me" type="checkbox" name="remember_me">
            <label for="remember_me">Ține-mă minte</label>

            <input type="submit" value="Conectare">
        </form>
    </div>
</body>

</html>
