<!DOCTYPE html>
<html lang="<%= article.language %>">

<head>
    <title><%= article.title %></title>
    <meta name="description" content="<%= article.description %>">
    <meta property="og:image" content="https://licariri.ro/articles/images/<%= article.id %>.webp"/>
<%- await include("meta"); _%>
<%_ if (! preview) { _%>
    <script type="text/javascript" src="/js/main-nav.js" defer></script>
<%_ } _%>
</head>

<body id="article-page">
<%_ if (! preview) { _%>
<%- await include("nav"); _%>
<%_ } _%>
    <div id="article-headline">
        <img id="article-thumbnail" src="/articles/images/<%= article.id %>.webp" class="no-select">
        <div id="thumbnail-text-container" class="center">
        <%_ if (articleStyle.title.position == "thumbnail") { _%>
            <h1 id="article-title" style="font-family: <%=
                articleStyle.title.font %>; font-size: <%=
                articleStyle.title.fontsizeArticle %>rem; font-weight: <%=
            articleStyle.title.fontweight %>; color: <%=
            articleStyle.title.color %>" <%_ if (articleStyle.title.fillStyle
            === 'on') { %> class="colour-complement-background"<%_ } _%>><%= article.title _%></h1>
            <%_ } _%>
            <%_ if (article.subtitle && articleStyle.subtitle.position == "thumbnail") { _%>
            <h2 id="article-subtitle" style="font-family: <%= articleStyle.subtitle.font %>; font-size: <%= articleStyle.subtitle.fontsize %>rem; font-weight: <%= articleStyle.subtitle.fontweight %>; color: <%= articleStyle.subtitle.color %>"><%= article.subtitle %></h2>
        <%_ } _%>
        </div>
    </div>
    <div class="article-info">
        <%_ if (articleStyle.title.position == "article") { _%>
        <div style="text-align: center">
            <h1 id="article-title" style="font-family: <%=
                articleStyle.title.font %>; font-size: <%= articleStyle.title.fontsizeArticle %>rem; font-weight: <%= articleStyle.title.fontweight %>; color: <%= articleStyle.title.color %>"><%= article.title %></h1>
        </div>
        <%_ } _%>
        <%_ if (article.subtitle && articleStyle.subtitle.position == "article") { _%>
        <div style="text-align: center">
            <h2 id="article-subtitle" style="font-family: <%= articleStyle.subtitle.font %>; font-size: <%= articleStyle.subtitle.fontsize %>rem; font-weight: <%= articleStyle.subtitle.fontweight %>; color: <%= articleStyle.subtitle.color %>"><%= article.subtitle %></h2>
        </div>
        <%_ } _%>
        <%_ if (article.authors.length) { _%>
        <%_ if (article.authors.length == 1) { _%>
        <h3>Autor:</h3>
        <%_ } else { _%>
        <h3>Autori:</h3>
        <%_ } _%>
        <%_ } _%>
        <%_ if (article.authors.length) { _%>
        <ul class="article-authors">
            <%_ for (author of article.authors) { _%>
            <%_ if (QUERY_ROUTES_ALLOWED) { _%>
            <li><a href="/query/?author=<%= author_%>"><%= author _%></a></li>
            <%_ } else { _%>
            <li><%= author _%></li>
            <%_ } _%>
            <%_ } _%>
        </ul>
        <%_ } _%>
        <div class="tags-date-grid">
            <ul class="article-tags">
                <%_ for (tag of article.tags) { _%>
                <%_ if (QUERY_ROUTES_ALLOWED) { _%>
                <li><a href="/query/?tag=<%= tag _%>">#<%= tag _%></a></li>
                <%_ } else { _%>
                <li>#<%= tag _%></li>
                <%_ } _%>
                <%_ } _%>
            </ul>
            <b class="article-date"><%= article.date %></b>
        </div>
        <%_ if (credits) { _%>
        <div id="article-contributors">
            <%_ if (credits.editorial.length) { _%>
            <h5>Redactare: <%= credits.editorial.sort().join(", ") %></h5>
            <%_ } _%>
            <%_ if (credits.dtp.length) { _%>
            <h5>Tehnoredactare: <%= credits.dtp.sort().join(", ") %></h5>
            <%_ } _%>
            <%_ if (credits.thumbnail.length) { _%>
            <h5>Grafică: <%= credits.thumbnail.sort().join(", ") %></h5>
            <%_ } _%>
        </div>
        <%_ } _%>
    </div>
    <span class="squiggly-line"></span>
    <div id="article-contents">
<%- article.contents _%>
    </div>
<%- await include("copyright") _%>
</body>

<%_ if (articleStyle.dropcap == "dropcap") { _%>
<script>
    articleContents = document.getElementById("article-contents");
    while(articleContents.firstChild.nodeName == "#text") {
        articleContents.removeChild(articleContents.firstChild);
    }
    articleContents.firstChild.classList.add("dropcap");
</script>
<%_ } _%>

</html>
