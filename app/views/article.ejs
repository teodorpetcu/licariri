<!DOCTYPE html>
<html lang="<%= article.language %>">
<%_
const getArticleCredits = (credited_for) => {
    if (! article.credits) return [];
    return article.credits
        .filter((c) => c.credited_for == credited_for)
        .map((c) => c.name);
}
_%>

<head>
    <title><%= article.title %></title>
    <meta name="description" content="<%= article.description %>">
    <meta property="og:image" content="https://licariri.ro/articles/images/<%= article.id %>.webp"/>
<%- await include("meta"); _%>
<%_ if (! preview) { _%>
    <script type="text/javascript" src="/js/main-nav.js" defer></script>
<%_ } _%>
</head>

<body id="article-page">
<%_ if (! preview) { _%>
<%- await include("nav"); _%>
<%_ } _%>
    <div id="article-headline">
        <%_ if (preview) { _%>
        <img id="article-thumbnail" src="/admin/articles/images/<%= article.id %>.webp" class="no-select">
        <%_ } else { %>
        <img id="article-thumbnail" src="/articles/images/<%= article.id %>.webp" class="no-select">
        <%_ } _%>
        <div id="thumbnail-text-container">
        <%_ if (article.style.title.position == "thumbnail") { _%>
            <h1 id="article-title" style="font-family: <%= article.style.title.font %>; font-size: <%= article.style.title.fontSizeArticle %>rem; font-weight: <%= article.style.title.fontWeight %>; color: <%= article.style.title.color %>" <%_ if (article.style.title.fillStyle) { %> class="colour-complement-background"<%_ } _%>><%= article.title _%><%_ } _%></h1>
            <%_ if (article.subtitle && article.style.subtitle.position == "thumbnail") { _%>
            <h2 id="article-subtitle" style="font-family: <%= article.style.subtitle.font %>; font-size: <%= article.style.subtitle.fontSize %>rem; font-weight: <%= article.style.subtitle.fontWeight %>; color: <%= article.style.subtitle.color %>"><%= article.subtitle %></h2>
        <%_ } _%>
        </div>
    </div>
    <div class="article-info">
        <%_ if (article.style.title.position == "article") { _%>
        <div style="text-align: center">
            <h1 id="article-title" style="font-family: <%= article.style.title.font %>; font-size: <%= article.style.title.fontSizeArticle %>rem; font-weight: <%= article.style.title.fontWeight %>; color: <%= article.style.title.color %>"><%= article.title %></h1>
        </div>
        <%_ } _%>
        <%_ if (article.subtitle && article.style.subtitle.position == "article") { _%>
        <div style="text-align: center">
            <h2 id="article-subtitle" style="font-family: <%= article.style.subtitle.font %>; font-size: <%= article.style.subtitle.fontSize %>rem; font-weight: <%= article.style.subtitle.fontWeight %>; color: <%= article.style.subtitle.color %>"><%= article.subtitle %></h2>
        </div>
        <%_ } _%>
        <%_ if (article.authors.length) { _%>
        <%_ if (article.authors.length == 1) { _%>
        <h3>Autor:</h3>
        <%_ } else { _%>
        <h3>Autori:</h3>
        <%_ } _%>
        <%_ } _%>
        <%_ if (article.authors.length) { _%>
        <ul class="article-authors">
            <%_ for (author of article.authors) { _%>
            <%_ if (QUERY_ROUTES_ALLOWED) { _%>
            <li><a href="/query/?author=<%= author_%>"><%= author _%></a></li>
            <%_ } else { _%>
            <li><%= author _%></li>
            <%_ } _%>
            <%_ } _%>
        </ul>
        <%_ } _%>
        <div class="tags-date-grid">
            <ul class="article-tags">
                <%_ for (tag of article.tags) { _%>
                <%_ if (QUERY_ROUTES_ALLOWED) { _%>
                <li><a href="/query/?tag=<%= tag _%>">#<%= tag _%></a></li>
                <%_ } else { _%>
                <li>#<%= tag _%></li>
                <%_ } _%>
                <%_ } _%>
            </ul>
            <b class="article-date"><%= article.date %></b>
        </div>
        <%_ if (article.credits) { _%>
        <div id="article-contributors">
            <%_ if (getArticleCredits("editorial").length) { _%>
            <h5>Redactare: <%= getArticleCredits("editorial").join(", ") %></h5>
            <%_ } _%>
            <%_ if (getArticleCredits("dtp").length) { _%>
            <h5>Tehnoredactare: <%= getArticleCredits("dtp").join(", ") %></h5>
            <%_ } _%>
            <%_ if (getArticleCredits("thumbnail").length) { _%>
            <h5>Grafică: <%= getArticleCredits("thumbnail").join(", ") %></h5>
            <%_ } _%>
        </div>
        <%_ } _%>
    </div>
    <span class="squiggly-line"></span>
    <div id="article-contents">
<%- contents _%>
    </div>
<%- await include("copyright") _%>
</body>

<%_ if (article.style.dropcap == "dropcap") { _%>
<script>
    articleContents = document.getElementById("article-contents");
    while(articleContents.firstChild.nodeName == "#text") {
        articleContents.removeChild(articleContents.firstChild);
    }
    articleContents.firstChild.classList.add("dropcap");
</script>
<%_ } _%>

</html>
