<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Administrare</title>
<%- include("meta"); _%>
    <link rel="stylesheet" href="/css/admin.css" type="text/css">
    <script type="text/javascript" src="/js/admin.js" defer></script>
</head>

<body id="admin-page">
    <div id="panels">
        <div id="userinfo">
            <p><%= user.id %></p>
            <form action="/admin/logout" method="POST">
                <button type="submit">
                    <i class="fa fa-sign-out"></i> Deconectare
                </button>
            </form>
        </div>
        <hr>
        <a href="#change-password">Schimbă-ți parola</a>
        <%_ if (canManageOtherUsers) { _%>
        <a href="#users">Gestionare utilizatori</a>
        <%_ } _%>
        <a href="#activity">Activitate recentă</a>
        <hr>
        <a href="#articles">Articole</a>
        <hr>
        <a href="#magazines">Reviste arhivate</a>
    </div>
    <div id="content"></div>
</body>

</html>
