<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Administrare</title>
<%- include("meta"); _%>
    <link rel="stylesheet" type="text/css" href="/css/admin.css?v0.1.1">
    <script type="text/javascript" src="/js/admin.js" defer></script>
</head>

<body id="admin-page">
    <div id="panels" class="sectionbox">
        <div id="userinfo">
            <p><%= user.id %></p>
            <form action="/admin/logout" method="POST">
                <button type="submit">
                    <i class="fa fa-sign-out"></i> Deconectare
                </button>
            </form>
        </div>
        <hr>
        <a id="panel-change-password" class="panel-button" href="#change-password">Schimbare parolă</a>
        <%_ if (canManageOtherUsers) { _%>
        <a id="panel-users" class="panel-button" href="#users">Gestionare utilizatori</a>
        <%_ } _%>
        <a id="panel-activity" class="panel-button" href="#activity">Activitate recentă</a>
        <hr>
        <a id="panel-articles" class="panel-button" href="#articles">Articole</a>
        <hr>
        <a id="panel-magazines" class="panel-button" href="#magazines">Reviste arhivate</a>
    </div>
    <div id="content"></div>
</body>

</html>
