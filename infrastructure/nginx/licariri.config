server {
    listen [::]:443 quic reuseport ipv6only=on;
    listen 443 quic reuseport default_server;
    listen [::]:443 ssl http2 ipv6only=on;
    listen 443 ssl http2;
    server_name licariri.ro;

    # inform the client that http/3.0 is available
    add_header Alt-Svc 'h3=":443"; ma=2592000; h3-29=":443"; ma=2592000';

    ssl_protocols TLSv1.3 TLSv1.2;
    ssl_certificate /etc/letsencrypt/live/licariri.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/licariri.ro/privkey.pem;

    server_tokens off;

    add_header Content-Security-Policy "default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self' mesota.ro instagram.com whatsapp.com facebook.com;img-src 'self' blob: data:;object-src 'none';script-src 'self' 'unsafe-inline' https:;script-src-attr 'none';style-src 'self' 'unsafe-inline' https:;upgrade-insecure-requests" always;
    add_header Referrer-Policy "no-referrer";
    add_header Strict-Transport-Security max-age=31536000;
    add_header X-Content-Type-Options "nosniff";

    add_header Pragma public;
    add_header Cache-Control "public";

    proxy_set_header Connection 'upgrade';
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    location ~* \.(?:png|jpe?g|svg|webp|css)$ {
        expires 28d;
        proxy_pass http://127.0.0.1:8000;
    }

    location /login {
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}

# redirect http to https
server {
    listen 80;
    server_name licariri.ro;
    return 301 https://$host$request_uri;
}

# deny requests that aren't directed to licariri.ro (such as accessing the
# server by IP address, which would circumvent Cloudflare protection)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 default_server;
    listen [::]:443 default_server;
    ssl_reject_handshake on;

    server_name _;
    # immediately close connection; send no response header
    return 444;
}
