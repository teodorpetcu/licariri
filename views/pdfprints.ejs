<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Ediții PRINT ale revistei</title>
    <%- include("meta"); %>
    <link rel="stylesheet" href="/css/admin.css" type="text/css">
</head>

<body>
    <h1>Adaugă ediție print</h1>
    <form action="/admin/pdfprints/add" method="post" autocomplete="off">
        <div>
            <label>Fișier PDF</label>
            <input required type="file" name="file"
                accept="application/pdf">
        </div>
        <div>
            <label>Descriere</label>
            <input required type="text"
                name="description">
        </div>
        <div>
            <label>Data ediției</label>
            <input required type="date"
                name="date" min="1960-01-01" max="<%= new Date().getFullYear() + '-12-31' %>">
        </div>
        <div>
            <input type="submit" value="Trimite">
        </div>
    </form>
</body>

</html>
