<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Adaugă utilizator</title>
    <%- include("meta"); %>
    <link rel="stylesheet" href="/css/admin.css" type="text/css">
</head>

<body>
    <%- include("theme"); %>
    <div>
        <h1>Adaugă utilizator</h1>
        <form action="/admin/user/add" method="post" autocomplete="off">
            <div>
                <label>Nume utilizator:</label>
                <input required type="text"
                    name="id" placeholder="">
            </div>
            <div>
                <label>Nume și prenume:</label>
                <input required type="text"
                    name="name" placeholder="POPESCU Ion">
            </div>
            <div>
                <label>Privilegiu:</label>
                <select required name="privilege">
                    <option value="SUPERUSER">Superutilizator</option>
                    <option value="COORDONATOR">Coordonator</option>
                    <option value="USER">muritor de rând</option>
                </select>
            </div>
            <div>
                <label>Parolă:</label>
                <input required type="password"
                    name="password" placeholder="">
            </div>
            <div>
                <input type="submit" value="Adaugă">
            </div>
        </form>
    </div>
</body>

</html>
