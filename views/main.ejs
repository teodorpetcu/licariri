<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Revista Licăriri</title>
    <%- include("meta"); %>
    <!--<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">-->
</head>

<body id="main-page">
    <div id="main-page-header">
        <div id="website-title-container">
            <h1>Licăriri</h1>
            <h6><i>revista elevilor Colegiului Național Dr. Ioan Meșotă, Brașov</i></h6>
        </div>
        <div id="links">
        </div>
    </div>
    <!--<div id="introduction-square" class="colour-complement-background">-->
        <!--<h2>ANUL XXXX</h2>-->
        <!--<p>renaștere și origini</p>-->
    <!--</div>-->
    <div style="text-align: center; margin-top: 450px">
        <h1 style="color: white">ARTICOLE</h1>
        <div id="article-thumbnail-grid">
        <% for (article of articles) { %>
            <a href="/articles/<%= article.id %>">
                <div class="article-thumbnail">
                    <% if (article.style.hide_title_in_thumbnail !== '') { %>
                    <h1 style="font-family: <%= article.style.title_font %>;
                                font-size: <%= article.style.title_fontsize_thumbnail %>rem;
                                font-weight: <%= article.style.title_fontweight %>;
                                color: <%= article.style.title_color %>"
                        class="center <% if (article.style.title_fill_style === '') { %>colour-complement-background<% } %>""
                        ><%= article.title %></h1>
                    <% } %>
                    <img src="/images/<%= article.id %>">
                </div>
            </a>
        <% } %>
        </div>

        <h1 style="color: white">ARHIVĂ REVISTE</h1>
        <div id="pdfprint-thumbnail-grid">
        <% for (pdfprint of pdfprints) { %>
            <div class="pdfprint-thumbnail">
                <a href="/pdfprints/<%= pdfprint.description %>.pdf">
                    <img src="/pdfprints/thumbnails/<%= pdfprint.description %>.png">
                </a>
                <br>
                <a class="pdfprint-description"
                    href="/pdfprints/<%= pdfprint.description %>.pdf"><%= pdfprint.description %></a>
            </div>
        <% } %>
        </div>
    </div>
</body>

<script type="text/javascript">
</script>

</html>
