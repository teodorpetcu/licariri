<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Revista Licăriri</title>
    <meta name="description" content="Licăriri, revista atât online cât și tipărită a elevilor Colegiului Național „Dr. Ioan Meșotă”, Brașov">
<%- await include("meta"); _%>
</head>

<body id="main-page">
<%_ if (articles.length) { _%>
<%- await include("main-nav"); _%>
<%_ } _%>
    <div id="main-page-header">
        <div id="website-title-container">
            <h1><a href="/">Licăriri</a></h1>
            <h6><i>revista elevilor Colegiului Național „Dr. Ioan Meșotă”, Brașov</i></h6>
        </div>
        <hr>
    </div>
    <div id="main-page-contents">
        <div id="introduction">
            <div id="types-of-texts">
                <div id="text">
                    <ul>
                        <li>proză</li>
                        <li>poezie</li>
                        <li>eseuri</li>
                        <li>cronică de cărți</li>
                        <li>interviuri</li>
                    </ul>
                </div>
                <div id="languages">
                    <ul>
                        <li>română</li>
                        <li>engleză</li>
                        <li>franceză</li>
                        <li>germană</li>
                    </ul>
                </div>
            </div>
            <ul id="drawings">
                <li>ilustrații</li>
                <li>fotografii</li>
            </ul>
            <div id="call-to-action">
                <h4>cu tema</h4>
                <h1>Nostalgie și vis</h1>
                <h4>pe care le poți trimite până pe</h4>
                <h2>15 decembrie 2024</h2>
                <h4>la adresa</h4>
                <h2><a href="mailto:licariri@mesota.ro">licariri@mesota.ro</a></h2>
                <h6>(dacă vrei, putem publica materialele pe care ni le trimiți pe site în loc să le adăugăm ediției tipărite)</h6>
            </div>
            <span class="squiggly-line"></span>
            <p>Între timp, îți propunem să răsfoiești un fragment din volumul publicat anul trecut:</p>
            <div class="pdfprint-highlight-container">
                <div class="pdfprint-thumbnail">
                    <a href="/pdfprints/Licăriri%202023-2024%20-%20fragment.pdf"><img src="/pdfprints/thumbnails/Licăriri%202023-2024.webp"></a>
                    <br>
                    <a class="pdfprint-description" href="/pdfprints/Licăriri%202023-2024%20-%20fragment.pdf">Licăriri 2023-2024 (fragment)</a>
                </div>
            </div>
        </div>

        <%_ if (articles.length) { _%>
        <div>
            <div id="article-thumbnail-grid">
            <%_ for (article of articles) { _%>
                <a href="/articles/<%= article.id %>">
                    <div class="article-thumbnail">
                        <%_ if (article.style.hide_title_in_thumbnail !== 'on') { _%>
                        <h1 style="font-family: <%= article.style.title_font %>; font-size: <%= article.style.title_fontsize_thumbnail %>rem; font-weight: <%= article.style.title_fontweight %>; color: <%= article.style.title_color %>" class="center<% if (article.style.title_fill_style === 'on') { %> colour-complement-background<%_ } _%>"><%= article.title %></h1>
                        <%_ } _%>
                        <img src="/articles/images/<%= article.id %>.webp">
                    </div>
                </a>
            <%_ } _%>
            </div>
        </div>
        <%_ } _%>

        <%_ if (pdfprints.length) { _%>
        <div>
            <p>Și chiar și revistele dintr-un trecut un pic mai îndepărtat. De ce nu?</p>
            <div id="pdfprint-thumbnail-grid">
            <%_ for (pdfprint of pdfprints) { _%>
                <div class="pdfprint-thumbnail">
                    <a href="/pdfprints/<%= pdfprint.description %>.pdf"><img src="/pdfprints/thumbnails/<%= pdfprint.description %>.webp"></a>
                    <br>
                    <a class="pdfprint-description" href="/pdfprints/<%= pdfprint.description %>.pdf"><%= pdfprint.description %></a>
                </div>
            <%_ } _%>
            </div>
        </div>
        <%_ } _%>
    </div>
<%- await include("copyright") _%>
</body>

<%_ if (articles.length) { _%>
<%- await include("main-nav-script"); _%>
<%_ } _%>

</html>
