<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Licăriri</title>
    <%- include("./header"); %>
</head>

<body>
    <%- include("./top-banner"); %>
    <div id="page-body">
        <div class="article-container">
            <div class="row">
                <div class="columns">
                <div class="grid">
                <% for (article of article_page) { %>
                    <div class="article-snippet">
                        <% if (article.has_thumbnail) { %>
                            <div style="text-align: center">
                                <a href="<%= article.id %>" class="title"><img src="images/<%= article.id %>"></a>
                            </div>
                        <% } %>

                        <a href="<%= article.id %>" class="title"><%= article.title %></a>

                        <%- include("authors") %>

                        <div class="description">
                            <%= article.description %>
                        </div>

                        <div>
                            <%- include("tags") %>
                        </div>
                    </div>
                <% } %>
                </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
