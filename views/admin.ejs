<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Administrare</title>
    <%- include("meta"); %>
    <link rel="stylesheet" href="/css/admin.css" type="text/css">
</head>

<body>
    <div id="account-pannel">
        <h1>Panou de administrare</h1>
        <a href="/admin/user/password">Schimbă-ți parola</a>
        <br>
        <% if (canManageUsers) { %>
            <a href="/admin/user/add">Adaugă utilizator</a>
        <% } %>
    </div>
    <div id="article-pannel">
        <h1>Articole</h1><!--
        --><a class="action-button" href="/admin/articles/new" id="add-article-button" ><!--
            --><input type="submit" value="+"></input><!--
        --></a>
        <% for (article of articles) { %>
        <div class="article-actions">
            <a href="/articles/<%= article.id %>">«<i><%= article.title %></i>»</a>,
            publicat <%= article.date %>
            <div>
                <a class="" href="/admin/articles/<%= article.id %>"><!--
                    --><input type="submit" value="Modifică"></input><!--
                --></a>
                <span style="padding: 20px;"></span>
                <% if (article.stage == "draft") { %>
                <form action="/admin/stage" method="post">
                    <input type="hidden" name="id"
                        value="<%= article.id %>">
                    <input type="hidden" name="stage"
                        value="public">
                    <input type="submit" onclick="return confirm(`Sigur vrei să publici articolul?`)" value="PUBLICĂ"></input>
                </form>
                <form action="/admin/stage" method="post">
                    <input type="hidden" name="id"
                        value="<%= article.id %>">
                    <input type="hidden" name="stage"
                        value="trash">
                    <input type="submit" onclick="return confirm(`Sigur vrei să ștergi articolul?`)" value="ȘTERGE" style="background-color: #BB0000"></input>
                </form>
                <% } else if (article.stage == "public") { %>
                <form action="/admin/stage" method="post">
                    <input type="hidden" name="id"
                        value="<%= article.id %>">
                    <input type="hidden" name="stage"
                        value="draft">
                    <input type="submit" onclick="return confirm(`Sigur vrei să ascunzi articolul?`)" value="ASCUNDE"></input>
                </form>
                <% } else if (article.stage == "trash") { %>
                <form action="/admin/stage" method="post">
                    <input type="hidden" name="id"
                        value="<%= article.id %>">
                    <input type="hidden" name="stage"
                        value="draft">
                    <input type="submit" onclick="return confirm(`Sigur vrei să restaurezi articolul?`)" value="RESTAUREAZĂ"></input>
                </form>
                <% } %>
            </div>
        </div>
        <% } %>
    </div>
</body>

</html>
