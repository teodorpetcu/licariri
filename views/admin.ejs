<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Administrare</title>
<%- include("meta"); _%>
    <link rel="stylesheet" href="/css/admin.css" type="text/css">
</head>

<body id="admin-page">
    <div id="panels">
        <div id="userinfo">
            <img src="/admin/user.png"><p><%= user.name %></p>
        </div>

        <hr>
        <button id="inputButton-tab-changePassword">Schimbă-ți parola</button>
        <%_ if (usersPages) { _%>
        <button id="inputButton-tab-manageUsers">Gestionare utilizatori</button>
        <%_ } _%>
        <button id="inputButton-tab-userActivity">Activitate utilizatori</button>

        <hr>
        <button id="inputButton-tab-articlesPublished">Articole publicate</button>
        <button id="inputButton-tab-articlesDrafts" class="active-button">Schițe</button>
        <button id="inputButton-tab-articlesTrash">Coșul de gunoi</button>

        <hr>

        <button id="inputButton-tab-pdfprints">Arhivă reviste</button>
        <button id="inputButton-tab-addpdfprint">Adaugă ediție tipărită</button>

        <form style="position: absolute; bottom: 10px; right:10px;" action="/admin/logout" method="POST">
            <button type="submit">
                <i class="fa fa-sign-out"></i> Deconectare
            </button>
        </form>
    </div>
    <div id="content">
        <div id="tab-changePassword">
            <h2>Autentificat ca: <%= user.name %></h2>
            <form action="/admin/user/password" method="post" autocomplete="off">
                <div>
                    <label for="original-password">Parola originală:</label>
                    <input required id="original-password" type="password" name="original">
                </div>
                <div>
                    <label for="password">Parolă nouă:</label>
                    <input required id="password" type="password" name="password">
                </div>
                <div>
                    <label for="confirm_password">Confirmare parolă:</label>
                    <input required id="confirm_password" type="password">
                </div>
                <div>
                    <input type="submit" value="Validează">
                </div>
            </form>
        </div>
        <%_ if (usersPages) { _%>
        <div id="tab-manageUsers" class="article-list">
            <h1>Gestionare utilizatori</h1>
            <%_ for ([pageNumber, page] of usersPages.entries()) { _%>
            <div id="tab-manageUsers-page<%= pageNumber %>" class="article-page<% if (pageNumber == 0) { %> active-page<%_ } _%>">
                <%_ for ([userIndex, user] of page.entries()) { _%>
                <div class="article-row">
                    <span><%= pageNumber * usersPages[0].length + userIndex + 1 %>.</span>
                    <span><%= user.id %></span>
                    <span><%= user.name %></span>
                    <span><%= user.privilege%></span>
                </div>
                <%_ } _%>
            </div>
            <%_ } _%>
            <div class="page-selector">
                <h5>Pagina:</h5>
                <%_ for (let i = 0; i < usersPages.length; i++) { _%>
                <button id="inputButton-manageUsers-page<%= i %>" <%_ if (i == 0) { _%>class="active-page-button"<%_ }%>><%= i  + 1 %></button>
                <%_ } _%>
            </div>
        </div>
        <%_ } _%>
        <div id="tab-userActivity">
        </div>
        <div id="tab-articlesPublished" class="article-list">
            <h1>Articole publicate</h1>
            <%_ if (publicArticlesPages.length) { _%>
            <%_ for ([pageNumber, page] of publicArticlesPages.entries()) { _%>
            <div id="tab-articlesPublished-page<%= pageNumber %>" class="article-page<% if (pageNumber == 0) { %> active-page<%_ } _%>">
                <%_ for ([articleIndex, article] of page.entries()) { _%>
                <div class="article-row">
                    <p><%= pageNumber * publicArticlesPages[0].length + articleIndex + 1 %>.</p>
                    <div>
                        <a href="/articles/<%= article.id _%>">«<i><%= article.title %></i>»</a>
                    </div>
                    <p><%= article.date %></p>
                    <form action="/admin/articles/<%= article.id %>" method="GET">
                        <button type="submit">Modifică</button>
                    </form>
                    <form action="/admin/stage" method="post">
                        <input type="hidden" name="id"
                            value="<%= article.id %>">
                        <input type="hidden" name="stage"
                            value="draft">
                        <input type="submit" onclick="return confirm(`Sigur vrei să ascunzi articolul?`)" value="Mută în schițe"></input>
                    </form>
                </div>
                <%_ } _%>
            </div>
            <%_ } _%>
            <div class="page-selector">
                <h5>Pagina:</h5>
                <%_ for (let i = 0; i < publicArticlesPages.length; i++) { _%>
                <button id="inputButton-articlesPublished-page<%= i %>" <%_ if (i == 0) { _%>class="active-page-button"<%_ }%>><%= i  + 1 %></button>
                <%_ } _%>
            </div>
            <%_ } else { _%>
            <p>(nimic)</p>
            <%_ } _%>
        </div>
        <div id="tab-articlesDrafts" class="article-list active-tab">
            <div style="display: flex; align-items: center; justify-content: center;">
                <h1>Schițe de articole</h1>
                <a id="add-article-form" href="/admin/articles/new">
                    <button type="submit">+</button>
                </a>
            </div>
            <%_ if (draftArticlesPages.length) { _%>
            <%_ for ([pageNumber, page] of draftArticlesPages.entries()) { _%>
            <div id="tab-articlesDrafts-page<%= pageNumber %>" class="article-page<% if (pageNumber == 0) { %> active-page<%_ } _%>">
                <%_ for ([articleIndex, article] of page.entries()) { _%>
                <div class="article-row">
                    <p><%= pageNumber * draftArticlesPages[0].length + articleIndex + 1 %>.</p>
                    <div>
                        <a href="/articles/<%= article.id %>">«<i><%= article.title %></i>»</a>
                    </div>
                    <p><%= article.date %></p>
                    <form action="/admin/articles/<%= article.id %>" method="GET">
                        <button type="submit">Modifică</button>
                    </form>

                    <form action="/admin/stage" method="post">
                        <input type="hidden" name="id" value="<%= article.id %>">
                        <input type="hidden" name="stage" value="public">
                        <input type="submit" onclick="return confirm(`Sigur vrei să publici articolul?`)" value="Publică articolul"></input>
                    </form>
                    <form action="/admin/stage" method="post">
                        <input type="hidden" name="id"
                            value="<%= article.id %>">
                        <input type="hidden" name="stage"
                            value="trash">
                        <input type="submit" onclick="return confirm(`Sigur vrei să ștergi articolul?`)" value="Mută în coșul de gunoi"></input>
                    </form>
                </div>
                <%_ } _%>
            </div>
            <%_ } _%>
            <div class="page-selector">
                <h5>Pagina:</h5>
                <%_ for (let i = 0; i < draftArticlesPages.length; i++) { _%>
                <button id="inputButton-articlesDrafts-page<%= i %>" <%_ if (i == 0) { _%>class="active-page-button"<%_ }%>><%= i  + 1 %></button>
                <%_ } _%>
            </div>
            <%_ } else { _%>
            <p>(nimic)</p>
            <%_ } _%>
        </div>
        <div id="tab-articlesTrash" class="article-list">
            <h1>Articole în coșul de gunoi</h1>
            <%_ if (trashArticlesPages.length) { _%>
            <%_ for ([pageNumber, page] of trashArticlesPages.entries()) { _%>
            <div id="tab-articlesTrash-page<%= pageNumber %>" class="article-page<% if (pageNumber == 0) { %> active-page<%_ } _%>">
                <%_ for ([articleIndex, article] of page.entries()) { _%>
                <div class="article-row">
                    <p><%= pageNumber * trashArticlesPages[0].length + articleIndex + 1 %>.</p>
                    <div>
                        <a href="/articles/<%= article.id _%>">«<i><%= article.title %></i>»</a>
                    </div>
                    <p><%= article.date %></p>
                    <form action="/admin/articles/<%= article.id %>" method="GET">
                        <button type="submit">Modifică</button>
                    </form>
                    <form action="/admin/stage" method="post">
                        <input type="hidden" name="id"
                            value="<%= article.id %>">
                        <input type="hidden" name="stage"
                            value="draft">
                        <input type="submit" onclick="return confirm(`Sigur vrei să restaurezi articolul?`)" value="Mută în schițe"></input>
                    </form>
                </div>
                <%_ } _%>
            </div>
            <%_ } _%>
            <div class="page-selector">
                <h5>Pagina:</h5>
                <%_ for (let i = 0; i < trashArticlesPages.length; i++) { _%>
                <button id="inputButton-articlesTrash-page<%= i %>" <%_ if (i == 0) { _%>class="active-page-button"<%_ }%>><%= i  + 1 %></button>
                <%_ } _%>
            </div>
            <%_ } else { _%>
            <p>(nimic)</p>
            <%_ } _%>
        </div>
        <div id="tab-pdfprints" class="article-list">
            <h1>Ediții ale revistei publicate pe site</h1>
            <%_ if (pdfprints.length) { _%>
            <%_ for ([pageNumber, page] of pdfprints.entries()) { _%>
            <div id="tab-pdfprints-page<%= pageNumber %>" class="article-page<% if (pageNumber == 0) { %> active-page<%_ } _%>">
                <%_ for ([pdfprintIndex, pdfprint] of page.entries()) { _%>
                <div class="article-row pdfprint-row">
                    <p><%= pageNumber * pdfprints[0].length + pdfprintIndex + 1 %>.</p>
                    <div>
                        <a href="/pdfprints/<%= pdfprint.filename _%>"><%= pdfprint.description %></a>
                    </div>
                    <p><%= pdfprint.date %> </p>
                    <form action="/admin/pdfprints/remove" method="POST">
                        <input type="hidden" name="description" value="<%= pdfprint.description %>">
                        <input type="submit" value="ȘTERGE">
                    </form>
                </div>
                <%_ } _%>
            </div>
            <div class="page-selector">
                <h5>Pagina:</h5>
                <%_ for (let i = 0; i < pdfprints.length; i++) { _%>
                <button id="inputButton-pdfprints-page<%= i %>" <%_ if (i == 0) { _%>class="active-page-button"<%_ }%>><%= i  + 1 %></button>
                <%_ } _%>
            </div>
            <%_ } _%>
            <%_ } else { _%>
            <p>(nimic)</p>
            <%_ } _%>
        </div>
        <div id="tab-addpdfprint">
            <h1>Adaugă ediție tipărită</h1>
            <form action="/admin/pdfprints/add" method="post" autocomplete="off" enctype="multipart/form-data">
                <div>
                    <label>Fișier PDF</label>
                    <input required type="file"
                        accept="application/pdf" name="pdffile">
                </div>
                <div>
                    <label>Descriere</label>
                    <input required type="text"
                        name="description">
                </div>
                <div>
                    <label>Data ediției</label>
                    <input required type="date"
                        name="date" min="1960-01-01" max="<%= new Date().getFullYear() + '-12-31' %>">
                </div>
                <div>
                    <input type="submit" value="Trimite">
                </div>
            </form>
        </div>
        </div>
    </div>
</body>

<script type="text/javascript">
    let activeTab = "articlesDrafts";
    const tabs = [
        "changePassword",
        <%_ if (usersPages) { _%>
        "manageUsers",
        <%_ } _%>
        "userActivity",
        "articlesPublished",
        "articlesDrafts",
        "articlesTrash",
        "pdfprints",
        "addpdfprint"
    ];

    const refreshActiveTab = () => {
        document.getElementsByClassName("active-tab")[0].classList.remove("active-tab");
        document.getElementById(`tab-${activeTab}`).classList.add("active-tab");
        document.getElementsByClassName("active-button")[0].classList.remove("active-button");
        document.getElementById(`inputButton-tab-${activeTab}`).classList.add("active-button");
    }

    tabs.forEach(tab => {
        document.getElementById(`inputButton-tab-${tab}`)
            .addEventListener("click", () => {activeTab = tab; refreshActiveTab()});
    });

    const refreshPage = (tab, page) => {
        document.getElementsByClassName("active-tab")[0].getElementsByClassName("active-page")[0].classList.remove("active-page");
        document.getElementById(`tab-${tab}-page${page}`).classList.add("active-page");
        document.getElementsByClassName("active-tab")[0].getElementsByClassName("active-page-button")[0].classList.remove("active-page-button");
        document.getElementById(`inputButton-${tab}-page${page}`).classList.add("active-page-button");
    }

    for (let [j, k] of [["articlesDrafts", <%= draftArticlesPages.length %>],
                        ["articlesPublished", <%= publicArticlesPages.length %>],
                        ["articlesTrash", <%= trashArticlesPages.length %>]]) {
        for (let i = 0; i < k; i++) {
            document.getElementById(`inputButton-${j}-page${i}`).addEventListener("click", () => {refreshPage(j, i)});
        }
    }
    <%_ if (usersPages) { _%>
    for (let i = 0; i < <%= usersPages.length %>; i++) {
        document.getElementById(`inputButton-manageUsers-page${i}`).addEventListener("click", () => {refreshPage("manageUsers", i)});
    }
    <%_ } _%>

</script>

<script>
    let password = document.getElementById("password");
    let confirmPassword = document.getElementById("confirm_password");

    const validatePassword = () => {
        if (password.value != confirmPassword.value) {
            confirmPassword.setCustomValidity("Parolele sunt diferite");
        } else {
            confirmPassword.setCustomValidity("");
        }
    }

    password.onchange = validatePassword;
    confirmPassword.onkeyup = validatePassword;
</script>

</html>
