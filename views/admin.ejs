<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Administrare</title>
    <%- include("meta"); %>
    <link rel="stylesheet" href="/css/admin.css" type="text/css">
</head>

<body>
    <%- include("theme"); %>
    <div id="account-pannel">
        <h1>Panou de administrare</h1>
        <a href="/admin/user/password">Schimbă-ți parola</a>
        <br>
        <% if (canManageUsers) { %>
            <a href="/admin/user/add">Adaugă utilizator</a>
        <% } %>
    </div>
    <div id="article-pannel">
        <h1>Articole</h1><!--
        --><a class="action-button" href="/admin/add" id="add-article-button" ><!--
            --><input type="submit" value="+"></input><!--
        --></a>
        <% for (article of articles) { %>
            <div class="article-item">
                <a href="/articles/<%= article.id %>">«<i><%= article.title %></i>»</a>,
                publicat <%= article.date %>
                <div>
                    <a class="action-button" href="/admin/modify/<%= article.id %>"><!--
                        --><input type="submit" value="Modifică"></input><!--
                    --></a>
                    <form action="/admin/remove" method="post">
                        <input type="hidden" name="id"
                            value="<%= article.id %>">
                        <input type="submit" onclick="return confirm('Sigur vrei să ștergi articolul?')" value="ȘTERGE"></input>
                    </form>
                </div>
            </div>
        <% } %>
    </div>
</body>

</html>
