<!DOCTYPE html>
<html lang="ro">

<head>
    <title><%= searchPageTitle _%></title>
    <meta name="description" content="Licăriri, revista atât online cât și tipărită a elevilor Colegiului Național „Dr. Ioan Meșotă”, Brașov">
<%- await include("meta"); _%>
</head>

<body id="main-page">
<%- await include("main-nav"); _%>
    <img id="main-page-background-image">
    <div id="main-page-header">
        <div id="website-title-container">
            <h1><a href="/">Licăriri</a></h1>
            <h6><i>revista elevilor Colegiului Național „Dr. Ioan Meșotă”, Brașov</i></h6>
        </div>
    </div>
    <div id="query-page-body">
    <h1><%= message _%></h1>
    <%_ if (articles.length > 0) { _%>
    <div id="query-results-grid" style="text-align: center">
        <%_ for (article of articles) { _%>
        <div class="article-queried">
            <a href="/articles/<%= article.id %>">
                <div class="article-thumbnail">
                    <%_ if (article.style.hide_title_in_thumbnail !== 'on') { _%>
                    <h1 style="font-family: <%= article.style.title_font %>; font-size: <%= article.style.title_fontsize_thumbnail %>rem; font-weight: <%= article.style.title_fontweight %>; color: <%= article.style.title_color %>" class="center<% if (article.style.title_fill_style === 'on') { %> colour-complement-background<%_ } _%>"><%= article.title %></h1>
                    <%_ } _%>
                    <img src="/articles/images/<%= article.id %>.webp">
                </div>
            </a>
            <div class="article-info">
                <h1><a href="/articles/<%= article.id _%>"><%= article.title _%></a></h1>
                <ul class="article-authors">
                    <%_ for (author of article.authors) { _%>
                    <li><a href="/query/?author=<%= author.name _%>"><%= author.name _%></a></li>
                    <%_ } _%>
                </ul>
                <ul class="article-tags">
                    <%_ for (tag of article.tags) { _%>
                    <li><a href="/query/?tag=<%= tag _%>">#<%= tag _%></a></li>
                    <%_ } _%>
                </ul>
                <p><%= article.description _%></p>
                <a class="read-more" href="/articles/<%= article.id _%>">Citește mai mult →</a>
            </div>
        </div>
        <%_ } _%>
    </div>
    <%_ } else { _%>
    <div id="searchbar-container">
        <h2>Poți încerca să efectuezi o căutare nouă:</h2>
        <form class="searchbar" action="/query" method="GET">
            <input required name="any" type="text" placeholder="Caută...">
            <button type="submit"><i class="fa fa-search"></i></button>
        </form>
        <h2>Sau să te întorci la pagina principală, <a href="/">apăsând aici</a></h2>
    </div>
    <%_ } _%>
    </div>
</body>

<%- await include("main-nav-script"); _%>

</html>
