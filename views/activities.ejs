<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Activitate utilizatori - Revista Licăriri</title>
<%- include("meta"); _%>
    <link rel="stylesheet" type="text/css" href="/css/admin.css">
</head>

<body>
    <div id="user-activity-grid">
        <h1>De la cea mai recentă activitate la cea mai veche:</h1>
        <div class="user-activity-grid-row">
            <p>Data</p>
            <p>Utilizator</p>
            <p>Acțiune</p>
        </div>
    <%_ for (activity of activities) { _%>
        <div class="user-activity-grid-row">
            <p><%= activity.timestamp %></p>
            <p><%= activity.user_id %></p>
            <p><%= activity.action %></p>
            <p><%= activity.target %></p>
        </div>
    <%_ } _%>
    </div>
</body>


</html>
