<div id="header" class="no-select">
    <div id="logo">
        <div id="logo-link">
            <a href="/">
                <h1 style="line-height: 0; padding-top: 10px;">LICĂRIRI</h1>
                <p style="font-size: 0.7rem; font-style: italic;">semper ad astra</p>
            </a>
        </div>
    </div>
    <nav id="main-nav">
        <a href="/">acasă</a>
        <a href="/">scrie-ne</a>
    </nav>
    <div id="main-nav-button">
        <input type="checkbox" id="menu-checkbox"/>
            <span></span>
            <span></span>
            <span></span>
    </div>
    <label id="theme-button">
        <input id="theme-button-checkbox" type="checkbox" size="17">
        <span></span>
    </label>
    <script>
        const menuCheckbox = document.getElementById("menu-checkbox");
        const mainNav = document.getElementById("main-nav");
        menuCheckbox.addEventListener("change", function() {
            if (this.checked) {
                mainNav.classList.add("open");
                document.body.classList.add("open");
            } else {
                mainNav.classList.remove("open");
                document.body.classList.remove("open");
            }
        })

        const themeButton = document.getElementById("theme-button-checkbox");
        const root = document.documentElement;
        let current_theme = localStorage.getItem("theme");
        if (current_theme === "dark") {
            root.classList.add("dark-theme");
            themeButton.checked = true;
        }
        themeButton.addEventListener("change", function() {
            if (this.checked) {
                localStorage.setItem("theme", "dark");
                root.classList.add("dark-theme");
            } else {
                localStorage.setItem("theme", "light");
                root.classList.remove("dark-theme");
            }
        })
    </script>
</div>
