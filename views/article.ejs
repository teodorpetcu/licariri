<!DOCTYPE html>
<html lang="ro">

<head>
    <title><%= article.title%></title>
    <%- include("meta"); %>
</head>

<body>
    <div id="article-headline">
        <img src="/images/<%= article.id %>" class="no-select">
        <h1 class="article-title"><%= article.title %></h1>
    </div>
    <div id="article-info">
        <div id="authors-list">
            <h3>Autori:</h3>
            <% for (let author of article.authors) { %>
            <div class="author">
                <span style="opacity: 0.5">—</span><!--
                --><a style="display: inline-block;" href="/query?author=<%= author.name %>"><%= author.name %></a><!--
                --><span style="opacity: 0.5">—</span>
            </div>
            <% } %>
            <b style="float: right; opacity: 0.8;"><%= article.date %></b>
        </div>
        <div id="tags-list">
            <% for (let tag of article.tags) { %>
                <a href="/query?tag=<%= tag %>">#<%= tag %></a>
            <% } %>
        </div>
    </div>
    <hr style="width: 18%"></hr>
    <div id="article-contents">
        <%- article.contents %>
    </div>
</body>

</html>
