<!DOCTYPE html>
<html lang="ro">

<head>
    <title><%= article.title%></title>
    <%- include("meta"); %>
</head>

<body>
    <div id="article-headline">
        <img id="article-thumbnail" src="/articles/images/<%= article.id %>.png" class="no-select">
        <% if (articleStyle.title_position == "thumbnail") { %>
        <h1 id="article-title"
            style="font-family: <%= articleStyle.title_font %>;
                    font-size: <%= articleStyle.title_fontsize_article %>rem;
                    font-weight: <%= articleStyle.title_fontweight %>;
                    color: <%= articleStyle.title_color %>"
            class="center <% if (articleStyle.title_fill_style === 'on') { %>colour-complement-background<% } %>""
            ><%= article.title %></h1>
        <% } %>
        <% if (articleStyle.subtitle_position == "thumbnail") { %>
        <h2 id="article-subtitle"
            style="font-family: <%= articleStyle.subtitle_font %>;
                    font-size: <%= articleStyle.subtitle_fontsize %>rem;
                    font-weight: <%= articleStyle.subtitle_fontweight %>;
                    color: <%= articleStyle.subtitle_color %>"
            class="center"
            ><%= article.subtitle %></h2>
        <% } %>
    </div>
    <div id="article-info">
        <% if (articleStyle.title_position == "article") { %>
        <div style="text-align: center">
        <h1 id="article-title"
            style="font-family: <%= articleStyle.title_font %>;
                    font-size: <%= articleStyle.title_fontsize_article %>rem;
                    font-weight: <%= articleStyle.title_fontweight %>;
                    color: <%= articleStyle.title_color %>"
            ><%= article.title %></h1>
        </div>
        <% } %>
        <div id="article-authors-list">
            <% if (article.authors.length) { %>
            <h3>Scris de:</h3>
            <% for (let author of article.authors) { %>
            <div class="author">
                <span style="opacity: 0.5">—</span><!--
                --><a style="display: inline-block;" href="/query?author=<%= author.name %>"><%= author.name %></a><!--
                --><span style="opacity: 0.5">—</span>
            </div>
            <% } %>
            <% } %>
        </div>
        <b id="article-date"><%= article.date %></b>
        <div id="article-tags-list">
            <% for (let tag of article.tags) { %>
            <a href="/query?tag=<%= tag %>">#<%= tag %></a>
            <% } %>
        </div>
    <hr style="width: 60%"></hr>
    </div>
    <div id="article-contents">
<%- article.contents %>
    </div>
</body>
<% if (articleStyle.subtitle_position == "thumbnail") { %>
<script>
    articleTitle = document.getElementById("article-title");
    articleSubtitle = document.getElementById("article-subtitle");
    articleSubtitle.style.marginTop =
        (articleTitle.offsetHeight +
        articleSubtitle.offsetHeight) + "px";
    <% if (articleStyle.dropcap == "dropcap") { %>
    articleContents = document.getElementById("article-contents");
    while(articleContents.firstChild.nodeName == "#text") {
        articleContents.removeChild(articleContents.firstChild);
    }
    articleContents.firstChild.classList.add("dropcap");
    <% } %>
</script>
<% } %>

</html>
