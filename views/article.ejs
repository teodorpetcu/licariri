<!DOCTYPE html>
<html lang="<%= article.language %>">

<head>
    <title><%= article.title%></title>
<%- include("meta"); _%>
</head>

<body>
<%- include("main-nav"); _%>
    <div id="article-headline">
        <img id="article-thumbnail" src="/articles/images/<%= article.id %>.png" class="no-select">
        <%_ if (articleStyle.title_position == "thumbnail") { _%>
        <h1 id="article-title" style="font-family: <%= articleStyle.title_font %>; font-size: <%= articleStyle.title_fontsize_article %>rem; font-weight: <%= articleStyle.title_fontweight %>; color: <%= articleStyle.title_color %>" class="center<% if (articleStyle.title_fill_style === 'on') { %> colour-complement-background<%_ } _%>"><%= article.title _%></h1>
        <%_ } _%>
        <%_ if (article.subtitle && articleStyle.subtitle_position == "thumbnail") { _%>
        <h2 id="article-subtitle" style="font-family: <%= articleStyle.subtitle_font %>; font-size: <%= articleStyle.subtitle_fontsize %>rem; font-weight: <%= articleStyle.subtitle_fontweight %>; color: <%= articleStyle.subtitle_color %>" class="center"><%= article.subtitle %></h2>
        <%_ } _%>
    </div>
    <div id="article-info">
        <%_ if (articleStyle.title_position == "article") { _%>
        <div style="text-align: center">
            <h1 id="article-title" style="font-family: <%= articleStyle.title_font %>; font-size: <%= articleStyle.title_fontsize_article %>rem; font-weight: <%= articleStyle.title_fontweight %>; color: <%= articleStyle.title_color %>"><%= article.title %></h1>
        </div>
        <%_ } _%>
        <%_ if (article.subtitle && articleStyle.subtitle_position == "thumbnail") { _%>
        <div style="text-align: center">
            <h2 id="article-subtitle" style="font-family: <%= articleStyle.subtitle_font %>; font-size: <%= articleStyle.subtitle_fontsize %>rem; font-weight: <%= articleStyle.subtitle_fontweight %>; color: <%= articleStyle.subtitle_color %>"><%= article.subtitle %></h2>
        </div>
        <%_ } _%>
        <%_ if (article.authors.length) { _%>
        <%_ if (article.authors.length == 1) { _%>
        <h3>Autor:</h3>
        <%_ } else { _%>
        <h3>Autori:</h3>
        <%_ } _%>
        <%_ } _%>
        <ul class="article-authors">
            <%_ for (let author of article.authors) { _%>
            <li><a href="/query/?author=<%= author.name _%>"><%= author.name _%></a></li>
            <%_ } _%>
        </ul>
        <b id="article-date"><%= article.date %></b>
        <ul class="article-tags">
            <%_ for (tag of article.tags) { _%>
            <li><a href="/query/?tag=<%= tag _%>">#<%= tag _%></a></li>
            <%_ } _%>
        </ul>
    <hr style="width: 60%"></hr>
    </div>
    <div id="article-contents">
<%- article.contents _%>
    </div>
<%- include("copyright") _%>
</body>

<%_ if (article.subtitle && articleStyle.subtitle_position == "thumbnail") { _%>
<script>
    articleTitle = document.getElementById("article-title");
    articleSubtitle = document.getElementById("article-subtitle");
    articleSubtitle.style.marginTop = (articleTitle.offsetHeight + articleSubtitle.offsetHeight) + "px";
</script>
<%_ } _%>

<%_ if (articleStyle.dropcap == "dropcap") { _%>
<script>
    articleContents = document.getElementById("article-contents");
    while(articleContents.firstChild.nodeName == "#text") {
        articleContents.removeChild(articleContents.firstChild);
    }
    articleContents.firstChild.classList.add("dropcap");
</script>
<%_ } _%>

<%- include("main-nav-script"); _%>

</html>
