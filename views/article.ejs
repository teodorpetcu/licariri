<!DOCTYPE html>
<html lang="ro">

<head>
    <title><%= article.title%></title>
    <%- include("./header"); %>
</head>

<body>
    <%- include("./top-banner"); %>
    <div class="article">
        <div class="header">
            <h1><%= article.title %></h1>
            <%- include("authors") %>
            <span style="float: right; opacity: 0.3;"><%= article.date %></span>
            <div id="tags">
                <%- include("tags") %>
            </div>
            <div style="text-align: center">
                <% if (article.thumbnail) { %>
                    <img src="<%= article.thumbnail %>">
                <% } %>
            </div>
        </div>
        <div class="contents">
            <%- article.contents %>
        </div>
    </div>
</body>

</html>
