<!DOCTYPE html>
<html lang="ro">

<head>
    <title><%= article.title%></title>
    <%- include("meta"); %>
</head>

<body>
    <%- include("header"); %>
    <%- include("theme"); %>
    <div id="page-body">
        <div class="article">
            <div class="headline">
                <h1><%= article.title %></h1>
                <div>
                    <%- include("authors") %>
                    <span style="float: right; opacity: 0.3;"><%= article.date %></span>
                </div>
                <%- include("tags") %>
                <% if (article.thumbnail) { %>
                    <div style="text-align: center">
                        <img src="images/<%= article.id %>">
                    </div>
                <% } %>
            </div>
            <div class="contents">
                <%- article.contents %>
            </div>
        </div>
    </div>
</body>

</html>
