<!DOCTYPE html>
<html lang="ro">

<head>
    <% if (action.startsWith("modify")) { %>
        <title>Modifică articol</title>
    <% } else { %>
        <title>Adaugă articol</title>
    <% } %>
    <%- include("meta"); %>
    <link rel="stylesheet" type="text/css" href="/css/admin.css">
</head>

<body>
    <div id="edit-article">
        <% if (action.startsWith("modify")) { %>
            <h1>Modifică articol</h1>
        <% } else { %>
            <h1>Adaugă articol</h1>
        <% } %>
        <form action="/admin/<%= action %>" method="post" autocomplete="off" enctype="multipart/form-data">
            <div>
                <label>Titlu:</label>
                <input required type="text"
                    name="title" placeholder="" value="<%= defaults.title %>">
            </div>

            <div>
                <label>Autori:</label>
                <div id="authors"></div>
                <button type="button" id="authors-add">Adaugă</button>
            </div>

            <div>
                <label>Tag-uri:</label>
                <div id="tags"></div>
                <button type="button" id="tags-add">Adaugă</button>
            </div>

            <div>
                <label>Text:</label>
                <textarea required name="content"><%= defaults.content %></textarea>
            </div>

            <div>
                <input type="submit" value="Trimite">
            </div>
        </form>
    </div>
</body>

<script>
    const authorsAddButton = document.getElementById("authors-add");
    const tagsAddButton = document.getElementById("tags-add");

    // `type` may be either "author" or "tag"
    const addField = (type = "", value = "") => {
        const fieldsContainer = document.getElementById(type + "s");
        let field = document.createElement("div");
        field.classList.add(type);

        let fieldInput = document.createElement("input");
        fieldInput.name = type +  "s[]";
        fieldInput.type = "text";
        fieldInput.value = value;

        let fieldDeleteButton = document.createElement("button");
        fieldDeleteButton.type = "button";
        fieldDeleteButton.classList.add("delete-button");
        fieldDeleteButton.textContent = "-";
        fieldDeleteButton.addEventListener("click", () => {
            fieldsContainer.removeChild(field)
        })

        field.appendChild(fieldInput);
        field.appendChild(fieldDeleteButton);
        fieldsContainer.appendChild(field);
    }

    <% for (author of defaults.authors) { %>
        addField("author", "<%= author.name %>");
    <% } %>
    <% for (tag of defaults.tags) { %>
        addField("tag", "<%= tag %>");
    <% } %>

    authorsAddButton.addEventListener("click", () => addField("author", ""));
    tagsAddButton.addEventListener("click", () => addField("tag", ""));
</script>

</html>
