<!DOCTYPE html>
<html lang="ro">

<head>
    <% if (action.startsWith("modify")) { %>
        <title>Modifică articol</title>
    <% } else { %>
        <title>Adaugă articol</title>
    <% } %>
    <%- include("meta"); %>
    <link rel="stylesheet" type="text/css" href="/css/admin.css">
</head>

<body>
    <div id="edit-article">
        <% if (action.startsWith("modify")) { %>
            <h1>Modifică articol</h1>
        <% } else { %>
            <h1>Adaugă articol</h1>
        <% } %>
        <form action="/admin/<%= action %>" method="post" autocomplete="off" enctype="multipart/form-data">
            <div>
                <label>Titlu:</label>
                <input required type="text"
                    name="title" placeholder="" value="<%= defaults.title %>">
            </div>

            <div>
                <label>Autori:</label>
                <div id="authors">
                    <% for (author of defaults.authors) { %>
                        <input type="text"
                            name="authors[]" value="<%= author.name %>">
                    <% } %>
                </div>
                <button type="button" id="authors-add">Adaugă</button>
            </div>

            <div>
                <label>Tag-uri:</label>
                <div id="tags">
                    <% for (tag of defaults.tags) { %>
                        <input type="text"
                            name="tags[]" value="<%= tag %>">
                    <% } %>
                </div>
                <button type="button" id="tags-add">Adaugă</button>
            </div>

            <div>
                <label>Text:</label>
                <textarea required name="content"><%= defaults.content %></textarea>
            </div>

            <div>
                <input type="submit" value="Trimite">
            </div>
        </form>
    </div>
</body>

<script>
    const dynamicAuthorsList = () => {
        const authorsContainer = document.getElementById("authors");
        const authorsAddButton = document.getElementById("authors-add");

        authorsAddButton.addEventListener("click", () => {
            let author = document.createElement("div");
            author.classList.add("author");

            let authorNameInput = document.createElement("input");
            authorNameInput.name = "authors[]";
            authorNameInput.type = "text";

            let authorDeleteButton = document.createElement("button");
            authorDeleteButton.type = "button";
            authorDeleteButton.classList.add("delete-button");
            authorDeleteButton.textContent = "-";
            authorDeleteButton.addEventListener("click", () => {
                authorsContainer.removeChild(author)
            })

            author.appendChild(authorNameInput);
            author.appendChild(authorDeleteButton);
            authorsContainer.appendChild(author);
        })
    }

    const dynamicTagsList = () => {
        const tagsContainer = document.getElementById("tags");
        const tagsAddButton = document.getElementById("tags-add");

        tagsAddButton.addEventListener("click", () => {
            let tag = document.createElement("div");
            tag.classList.add("tag");

            let tagNameInput = document.createElement("input");
            tagNameInput.name = "tags[]";
            tagNameInput.type = "text";

            let tagDeleteButton = document.createElement("button");
            tagDeleteButton.type = "button";
            tagDeleteButton.classList.add("delete-button");
            tagDeleteButton.textContent = "-";
            tagDeleteButton.addEventListener("click", () => {
                tagsContainer.removeChild(tag)
            })

            tag.appendChild(tagNameInput);
            tag.appendChild(tagDeleteButton);
            tagsContainer.appendChild(tag);
        })
    }

    dynamicAuthorsList();
    dynamicTagsList();
</script>

</html>
