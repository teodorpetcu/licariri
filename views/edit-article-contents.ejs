<!DOCTYPE html>
<html lang="ro">

<head>
    <title>Editează articol</title>
    <%- include("meta"); %>
    <link rel="stylesheet" type="text/css" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body id="edit-article-page">
    <div id="editing-stages">
        <button type="button" id="button-edit-content">Conținut</button>
        <button id="button-edit-dtp">Tehnoredactare</button>
        <button id="button-preview">Previzualizare</button>
    </div>
    <form action="/admin/articles/<%= defaults.id %>" method="post" autocomplete="off" enctype="multipart/form-data">
        <div id="edit-article-content">
            <div id="left">
                <h1>Editează articol</h1>
                <label>Titlu:</label>
                <input required id="input-title" type="text"
                    name="title" value="<%= defaults.title %>">

                <label>Subtitlu:</label>
                <input id="input-subtitle" type="text"
                    name="subtitle" value="<%= defaults.subtitle %>">

                <label>Limba articolului:</label>
                <select required id="input-article-language"
                    name="language">
                    <option value="ro">Română</option>
                    <option value="en">Engleză</option>
                    <option value="de">Germană</option>
                    <option value="fr">Franceză</option>
                </select>

                <div class="input-multiple">
                    <label>Autori:</label>
                    <div id="input-authors"></div>
                    <button class="add-button" type="button" id="authors-add-button">Adaugă</button>
                </div>

                <div class="input-multiple">
                    <label>Tag-uri:</label>
                    <div id="input-tags"></div>
                    <button class="add-button" type="button" id="tags-add-button">Adaugă</button>
                </div>
            </div>
            <div id="right">
                <textarea required id="input-article-contents"
                    name="content"><%= defaults.content %></textarea>
            </div>
        </div>
        <div id="edit-article-dtp">
            <div class="article-thumbnail no-select" style="width: 300px; position: absolute; right:
                100px; top: 300px; transform: translateY(-50%);">
                <h1 id="preview-minified-thumbnail-title" class="center"></h1>
                <img id="preview-minified-thumbnail-image" src="">
            </div>

            <label>Thumbnail:</label>
            <input id="input-article-thumbnail"
                type="file" accept="image/*" name="thumbnail">
            <button type="button" id="reset-thumbnail-button">RESETARE</button>
            <label>Persoana care a realizat thumbnail-ul:</label>
            <input id="input-article-thumbnail-credit"
                type="text" placeholder="Nume Prenume" name="thumbnail_credit">

            <label>Ascunde titlul din thumbnail:</label>
            <input id="input-title-hide-on-thumbnail"
                type="checkbox" name="hide_title_in_thumbnail"
                <% if (defaults.style.hide_title_in_thumbnail) { %>
                checked
                <% } %>>

            <label>Fontul titlului:</label>
            <select id="input-title-font" name="title_font">
                <option value="Baskervville">Baskervville</option>
                <option value="Kameron" <% if (defaults.style.title_font == "Kameron") { %>selected<% } %>>Kameron</option>
            </select>

            <label>Mărimea fontului titlului din thumbnail:</label>
            <input id="input-title-thumbnail-font-size"
                name="title_fontsize_thumbnail"
                value="<%= defaults.style.title_fontsize_thumbnail %>"
                type="range" min="1.5" max="2.5" step="0.1" >

            <label>Mărimea fontului titlului din articol:</label>
            <input id="input-title-article-font-size"
                name="title_fontsize_article"
                value="<%= defaults.style.title_fontsize_article %>"
                type="range" min="2" max="5" step="0.1" >

            <label>Grosimea fontului titlului:</label>
            <input id="input-title-fontweight"
                name="title_fontweight"
                value="<%= defaults.style.title_fontweight %>"
                type="range" min="400" max="800" step="50">

            <!--TITLE FILL STYLE == <select>-->
            <label>Titlul contrastează cu fundalul (ignoră culoarea):</label>
            <input id="input-title-contrast-background"
                type="checkbox" name="title_fill_style"
                <% if (defaults.style.title_fill_style) { %>
                checked
                <% } %>>

            <label>Culoarea titlului:</label>
            <input id="input-title-color" name="title_color"
                value="<%= defaults.style.title_color %>"
                type="color">

            <label>Poziția titlului în articol:</label>
            <select id="input-title-position" name="title_position">
                <option value="thumbnail">Pe thumbnail</option>
                <option value="article" <% if (defaults.style.title_position == "article") { %>selected<% } %>>Sub thumbnail</option>

            </select>

            <label>Fontul subtitlului:</label>
            <select id="input-subtitle-font" name="subtitle_font">
                <option value="Baskervville">Baskervville</option>
                <option value="Kameron" <% if (defaults.style.subtitle_font == "Kameron") { %>selected<% } %>>Kameron</option>
            </select>

            <label>Mărimea fontului subtitlului din articol:</label>
            <input id="input-subtitle-font-size" name="subtitle_fontsize"
                value="<%= defaults.style.subtitle_fontsize %>"
                type="range" min="1" max="2" step="0.1" >

            <label>Grosimea fontului subtitlului:</label>
            <input id="input-subtitle-fontweight" name="subtitle_fontweight"
                value="<%= defaults.style.subtitle_fontweight %>"
                type="range" min="400" max="800" step="50">

            <label>Culoarea subtitlului:</label>
            <input id="input-subtitle-color"
                value="<%= defaults.style.subtitle_color %>"
                type="color" name="subtitle_color">

            <label>Poziția subtitlului în articol:</label>
            <select id="input-subtitle-position" name="subtitle_position">
                <option value="thumbnail">Pe thumbnail</option>
                <option value="article" <% if (defaults.style.subtitle_position == "article") { %>selected<% } %>>Sub thumbnail</option>
            </select>

            <label>Stilul primei litere din text:</label>
            <select id="input-first-letter-style" name="dropcap">
                <option value="default">Fără stil</option>
                <option value="dropcap" <% if (defaults.style.dropcap == "dropcap") { %>selected<% } %>>Dropcap cu border</option>
            </select>
        </div>
        <input id="article-submit-button" type="submit" value="Trimite">
    </form>
    <div id="preview-page">
        <div id="article-headline">
            <img id="article-thumbnail" src="" class="no-select">
            <h1 id="article-title"></h1>
            <h2 id="article-subtitle"></h2>
        </div>
        <div id="article-contributors">
            <!--<h5>Redactare:</h5>-->
            <!--<h5>Tehnoredactare:</h5>-->
            <h5 id="article-thumbnail-credit"></h5>
        </div>
        <div id="article-info">
            <div id="article-alternate-title-position"></div>
            <h3 id="article-authors-title"></h3>
            <ul class="article-authors" id="article-authors-list">
            </ul>
            <b id="article-date"><%= defaults.date %></b>
            <ul class="article-tags" id="article-tags-list">
            </ul>
        </div>
        <hr style="width: 18%">
        <div id="article-contents"></div>
    </div>
</body>

<script type="text/javascript">
    const authorsAddButton = document.getElementById("authors-add-button");
    const tagsAddButton = document.getElementById("tags-add-button");

    // `type` may be either "author" or "tag"
    const addField = (type = "", value = "") => {
        const fieldsContainer = document.getElementById("input-" + type + "s");
        let field = document.createElement("div");
        field.classList.add(type);

        let fieldInput = document.createElement("input");
        fieldInput.name = type + "s[]";
        if (type == "image") {
            fieldInput.type = "file";
            fieldInput.accept = "image/*";
        } else {
            fieldInput.type = "text";
        }
        fieldInput.value = value;

        let fieldDeleteButton = document.createElement("button");
        fieldDeleteButton.type = "button";
        fieldDeleteButton.classList.add("delete-button");
        fieldDeleteButton.classList.add("fa");
        fieldDeleteButton.classList.add("fa-trash-o");
        fieldDeleteButton.addEventListener("click", () => {
            fieldsContainer.removeChild(field)
        })

        field.appendChild(fieldInput);
        field.appendChild(fieldDeleteButton);
        fieldsContainer.appendChild(field);
    }

    <% for (author of defaults.authors) { %>
        addField("author", "<%= author.name %>");
    <% } %>
    <% for (tag of defaults.tags) { %>
        addField("tag", "<%= tag %>");
    <% } %>

    authorsAddButton.addEventListener("click", () => addField("author", ""));
    tagsAddButton.addEventListener("click", () => addField("tag", ""));
</script>

<script type="text/javascript">
    const contentPage = document.getElementById("edit-article-content");
    const dtpPage = document.getElementById("edit-article-dtp");
    const previewPage = document.getElementById("preview-page");

    // on Content page
    const inputTitle = document.getElementById("input-title");
    const inputSubtitle = document.getElementById("input-subtitle");
    const inputAuthors = document.getElementsByName("authors[]");
    const inputTags = document.getElementsByName("tags[]");
    const inputContents = document.getElementById("input-article-contents");

    // on DTP page
    const inputThumbnail = document.getElementById("input-article-thumbnail");
    const inputThumbnailCredits = document.getElementById("input-article-thumbnail-credit");
    const inputThumbnailReset = document.getElementById("reset-thumbnail-button");
    const inputTitleContrastBackground = document.getElementById("input-title-contrast-background");
    const inputTitleHideOnThumbnail = document.getElementById("input-title-hide-on-thumbnail");
    const inputTitleColor = document.getElementById("input-title-color");
    const inputTitleFont = document.getElementById("input-title-font");
    const inputTitleThumbnailFontSize = document.getElementById("input-title-thumbnail-font-size");
    const inputTitleArticleFontSize = document.getElementById("input-title-article-font-size");
    const inputTitleFontWeight = document.getElementById("input-title-fontweight");
    const inputTitlePosition = document.getElementById("input-title-position");
    const inputSubtitleColor = document.getElementById("input-subtitle-color");
    const inputSubtitleFont = document.getElementById("input-subtitle-font");
    const inputSubtitlePosition = document.getElementById("input-subtitle-position");
    const inputSubtitleFontSize = document.getElementById("input-subtitle-font-size");
    const inputSubtitleFontWeight = document.getElementById("input-subtitle-fontweight");
    const inputfirstLetterStyle = document.getElementById("input-first-letter-style");

    const previewMinifiedThumbnailImage = document.getElementById("preview-minified-thumbnail-image");
    const previewMinifiedThumbnailTitle = document.getElementById("preview-minified-thumbnail-title");

    // on Preview page
    const previewArticleThumbnail = document.getElementById("article-thumbnail");
    const previewArticleThumbnailCredits = document.getElementById("article-thumbnail-credit");
    const previewArticleTitle = document.getElementById("article-title");
    const previewArticleSubtitle = document.getElementById("article-subtitle");
    const previewArticleContents = document.getElementById("article-contents");
    const previewArticleAuthors = document.getElementById("article-authors-list");
    const previewArticleAuthorsTitle = document.getElementById("article-authors-title");
    const previewArticleTags = document.getElementById("article-tags-list");

    const previewArticleDefaultTitlePosition = document.getElementById("article-headline");
    const previewArticleAlternateTitlePosition = document.getElementById("article-alternate-title-position");

    inputThumbnailReset.addEventListener("click", () => {
        inputThumbnail.value = '';
        inputThumbnail.dispatchEvent(new Event("change"));
    });

    const setFont = (elem, font) => {
        elem.style.fontFamily = font;
    }

    const setFontSizeREM = (elem, fontSize) => {
        elem.style.fontSize = fontSize + "rem";
    }

    setFont(previewArticleTitle, inputTitleFont.value);
    setFont(previewMinifiedThumbnailTitle, inputTitleFont.value);

    inputTitleFont.addEventListener("change", () => {
        setFont(previewArticleTitle, inputTitleFont.value);
        setFont(previewMinifiedThumbnailTitle, inputTitleFont.value);
    })

    inputTitleThumbnailFontSize.addEventListener("change", () => {
        setFontSizeREM(previewMinifiedThumbnailTitle, inputTitleThumbnailFontSize.value);
    })
    setFontSizeREM(previewMinifiedThumbnailTitle, inputTitleThumbnailFontSize.value);

    inputTitleFontWeight.addEventListener("change", () => {
        previewMinifiedThumbnailTitle.style.fontWeight = inputTitleFontWeight.value;
        previewArticleTitle.style.fontWeight = inputTitleFontWeight.value;
    })

    const updateTitleColourMode = () => {
        if (inputTitleContrastBackground.checked) {
            previewArticleTitle.classList.add("colour-complement-background");
            previewMinifiedThumbnailTitle.classList.add("colour-complement-background");
        } else {
            previewArticleTitle.classList.remove("colour-complement-background");
            previewMinifiedThumbnailTitle.classList.remove("colour-complement-background");
        }
    }
    updateTitleColourMode();

    inputTitleContrastBackground.addEventListener("click", updateTitleColourMode);

    const updateThumbnail = (imgObj) => {
        const [thumbnail] = inputThumbnail.files;
        if (thumbnail) {
            imgObj.src = URL.createObjectURL(thumbnail)
        } else {
            imgObj.src = "/admin/articles/images/<%= defaults.id %>.png"
        }
    }
    updateThumbnail(previewMinifiedThumbnailImage);

    inputThumbnail.addEventListener("change", () => {
        updateThumbnail(previewMinifiedThumbnailImage);
    });
    inputTitleColor.addEventListener("change", () => {
        previewMinifiedThumbnailTitle.style.color = inputTitleColor.value;
    });
    previewMinifiedThumbnailTitle.style.color = inputTitleColor.value;

    const actionHideThumbnailTitle = () => {
        if (inputTitleHideOnThumbnail.checked) {
            previewMinifiedThumbnailTitle.style.display = "none";
        } else {
            previewMinifiedThumbnailTitle.style.display = "block";
        }
    }
    actionHideThumbnailTitle();
    inputTitleHideOnThumbnail.addEventListener("change", actionHideThumbnailTitle);

    const showContentPage = () => {
        contentPage.style.display = "grid";
        dtpPage.style.display = "none";
        previewPage.style.display = "none";
    }

    const showDTPPage = () => {
        contentPage.style.display = "none";
        dtpPage.style.display = "grid";
        previewPage.style.display = "none";
        previewMinifiedThumbnailTitle.textContent = inputTitle.value;
    }

    const showPreviewPage = () => {
        contentPage.style.display = "none";
        dtpPage.style.display = "none";
        previewPage.style.display = "block";

        // clear authors and tags, since otherwise they would just pile up
        while (previewArticleAuthors.childElementCount) {
            previewArticleAuthors.removeChild(previewArticleAuthors.lastChild);
        }
        previewArticleTags.textContent = "";

        let authors = []; inputAuthors.forEach((i) => {if(i.value.trim()) authors.push(i.value.trim())});
        authors.sort();

        if (authors.length >= 1) {
            previewArticleAuthorsTitle.textContent = "Autor";
            if (authors.length > 1) {
                previewArticleAuthorsTitle.textContent += "i";
            }
            previewArticleAuthorsTitle.textContent += ":";
        }

        for (author of authors) {
            let authorDiv = document.createElement("li");
            let authorLink = document.createElement("a");
            authorLink.href = "#";
            authorLink.style.display = "inline-block";
            authorLink.textContent = author;

            authorDiv.appendChild(authorLink);
            previewArticleAuthors.append(authorDiv);
        }

        for (inputTag of inputTags) {
            if (!inputTag.value.trim()) continue;
            let tagLink= document.createElement("a");
            tagLink.href = "#";
            tagLink.textContent = "#" + inputTag.value.trim();
            let tagDiv = document.createElement("li");
            tagDiv.append(tagLink)
            previewArticleTags.append(tagDiv);
        }

        updateThumbnail(previewArticleThumbnail);

        previewArticleTitle.textContent = inputTitle.value.trim();
        previewArticleTitle.style.color = inputTitleColor.value;
        setFontSizeREM(previewArticleTitle, inputTitleArticleFontSize.value);

        previewArticleSubtitle.textContent = inputSubtitle.value.trim();
        previewArticleSubtitle.style.color = inputSubtitleColor.value;
        previewArticleSubtitle.style.fontFamily = inputSubtitleFont.value;
        previewArticleSubtitle.style.fontWeight = inputSubtitleFontWeight.value;
        setFontSizeREM(previewArticleSubtitle, inputSubtitleFontSize.value);

        previewArticleContents.innerHTML = DOMPurify.sanitize(marked.parse(inputContents.value));
        <!--const articleDate = document.getElementById("preview-article-date");-->
        if (inputThumbnailCredits.value) {
            previewArticleThumbnailCredits.textContent = "Grafică: " + inputThumbnailCredits.value;
        } else {
            previewArticleThumbnailCredits.textContent = "";
        }

        if (inputTitlePosition.value == "article") {
            previewArticleTitle.classList.remove("center");
            previewArticleAlternateTitlePosition.append(previewArticleTitle);
        } else {
            previewArticleTitle.classList.add("center");
            previewArticleDefaultTitlePosition.append(previewArticleTitle);
        }
        if (inputSubtitlePosition.value == "article") {
            previewArticleSubtitle.classList.remove("center");
            previewArticleAlternateTitlePosition.append(previewArticleSubtitle);
            previewArticleSubtitle.style.marginTop = 0;
        } else {
            previewArticleSubtitle.classList.add("center");
            previewArticleDefaultTitlePosition.append(previewArticleSubtitle);
            // todo: maybe make this variable somehow
            previewArticleSubtitle.style.marginTop =
                (previewArticleTitle.offsetHeight +
                previewArticleSubtitle.offsetHeight) + "px";
        }

        previewArticleContents.firstChild.classList.remove("dropcap");
        switch(inputfirstLetterStyle.value) {
            case "dropcap":
                previewArticleContents.firstChild.classList.add("dropcap");
                break;
        }
    }

    document.getElementById("button-edit-content").addEventListener("click", showContentPage);
    document.getElementById("button-edit-dtp").addEventListener("click", showDTPPage);
    document.getElementById("button-preview").addEventListener("click", showPreviewPage);

    window.addEventListener("beforeunload", (event) => {
        event.preventDefault();
        event.returnValue = true;
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>

</html>
