<!DOCTYPE html>
<html lang="ro">

<head>
    <% if (action.startsWith("modify")) { %>
    <title>Modifică articol</title>
    <% } else { %>
    <title>Adaugă articol</title>
    <% } %>
    <%- include("meta"); %>
    <link rel="stylesheet" type="text/css" href="/css/admin.css">
</head>

<body>
    <div id="editing-stages">
        <button type="button" id="button-edit-content">Conținut</button>
        <button id="button-edit-dtp">Tehnoredactare</button>
        <button id="button-preview">Previzualizare</button>
    </div>
    <form action="/admin/<%= action %>" method="post" autocomplete="off" enctype="multipart/form-data">
        <div id="edit-article-content">
            <div id="left">
            <% if (action.startsWith("modify")) { %>
            <h1>Modifică articol</h1>
            <% } else { %>
            <h1>Adaugă articol</h1>
            <% } %>
                <div>
                    <label>Titlu:</label>
                    <input required id="input-title" type="text"
                        name="title" placeholder="" value="<%= defaults.title %>">
                </div>

                <div>
                    <label>Autori:</label>
                    <div id="input-authors"></div>
                    <button type="button" id="authors-add-button">Adaugă</button>
                </div>

                <div>
                    <label>Tag-uri:</label>
                    <div id="input-tags"></div>
                    <button type="button" id="tags-add-button">Adaugă</button>
                </div>
            </div>
            <div id="right">
                <textarea required id="input-article-contents"
                    name="content"><%= defaults.content %></textarea>
            </div>
        </div>
        <div id="edit-article-dtp">
            <div>
                <label>Thumbnail:</label>
                <input required id="input-article-thumbnail"
                    type="file" accepts="image/*" name="thumbnail">
                <button type="button" id="reset-thumbnail-button"
                    onclick="document.getElementById('input-article-thumbnail').value
                    = ''">RESETARE</button>
            </div>
        </div>
        <!--<input type="submit" value="Trimite">-->
    </form>
    <div id="preview-page">
        <div id="article-headline">
            <img id="preview-thumbnail" src="/images/" class="no-select">
            <h1 id="preview-thumbnail-title" class="article-title"></h1>
        </div>
        <div id="article-info">
            <div id="authors-list">
                <h3>Scris de:</h3>
            </div>
            <b id="preview-article-date" style="float: right; opacity: 0.8;"></b>
            <div id="tags-list">
            </div>
        </div>
        <hr style="width: 18%"></hr>
        <div id="article-contents"></div>
    </div>
</body>

<script>
    const authorsAddButton = document.getElementById("authors-add-button");
    const tagsAddButton = document.getElementById("tags-add-button");

    // `type` may be either "author" or "tag"
    const addField = (type = "", value = "") => {
        const fieldsContainer = document.getElementById("input-" + type + "s");
        let field = document.createElement("div");
        field.classList.add(type);

        let fieldInput = document.createElement("input");
        fieldInput.name = type +  "s[]";
        fieldInput.type = "text";
        fieldInput.value = value;

        let fieldDeleteButton = document.createElement("button");
        fieldDeleteButton.type = "button";
        fieldDeleteButton.classList.add("delete-button");
        fieldDeleteButton.textContent = "-";
        fieldDeleteButton.addEventListener("click", () => {
            fieldsContainer.removeChild(field)
        })

        field.appendChild(fieldInput);
        field.appendChild(fieldDeleteButton);
        fieldsContainer.appendChild(field);
    }

    <% for (author of defaults.authors) { %>
        addField("author", "<%= author.name %>");
    <% } %>
    <% for (tag of defaults.tags) { %>
        addField("tag", "<%= tag %>");
    <% } %>

    authorsAddButton.addEventListener("click", () => addField("author", ""));
    tagsAddButton.addEventListener("click", () => addField("tag", ""));
</script>

<script>
    contentPage = document.getElementById("edit-article-content");
    dtpPage = document.getElementById("edit-article-dtp");
    previewPage = document.getElementById("preview-page");
    const showContentPage = () => {
        contentPage.style.display = "block";
        dtpPage.style.display = "none";
        previewPage.style.display = "none";
    }

    const showDTPPage = () => {
        contentPage.style.display = "none";
        dtpPage.style.display = "block";
        previewPage.style.display = "none";
    }

    const showPreviewPage = () => {
        contentPage.style.display = "none";
        dtpPage.style.display = "none";
        previewPage.style.display = "block";
        // todo: trim() title & authors & tags etc., preferrably in the input
        // fields themselves

        const articleTitle = document.getElementById("input-title");
        const articleContents = document.getElementById("input-article-contents");
        const authors = document.getElementsByName("authors[]");
        const tags = document.getElementsByName("tags[]");
        let [thumbnail] = document.getElementById("input-article-thumbnail").files;

        const previewArticleThumbnail = document.getElementById("preview-thumbnail");
        const previewTitle = document.getElementById("preview-thumbnail-title")
        const previewArticleContents = document.getElementById("article-contents")
        const previewArticleAuthors = document.getElementById("authors-list")
        const previewArticleTags = document.getElementById("tags-list")

        while (previewArticleAuthors.childElementCount > 1) {
            previewArticleAuthors.removeChild(previewArticleAuthors.lastChild);
        }
        previewArticleTags.textContent = "";

        for (author of authors) {
            if (!author.value) continue;
            let authorDiv = document.createElement("div");
            authorDiv.classList.add("author");
            let span1 = document.createElement("span");
            span1.style.opacity = "0.5";
            span1.textContent = "—";
            let span2 = document.createElement("span");
            span2.style.opacity = "0.5";
            span2.textContent = "—";
            let authorLink = document.createElement("a");
            authorLink.href = "#";
            authorLink.style.display = "inline-block";
            authorLink.textContent = author.value;

            authorDiv.appendChild(span1);
            authorDiv.appendChild(authorLink);
            authorDiv.appendChild(span2);
            previewArticleAuthors.append(authorDiv);
        }

        for (tag of tags) {
            if (!tag.value) continue;
            let tagLink= document.createElement("a");
            tagLink.href = "#";
            tagLink.textContent = "#" + tag.value;
            previewArticleTags.append(tagLink);
        }

        if (thumbnail) {
            previewArticleThumbnail.src = URL.createObjectURL(thumbnail)
        } else {
            previewArticleThumbnail.src = "/images/<%= defaults.id %>"
        }
        previewTitle.textContent = articleTitle.value;
        previewArticleContents.innerHTML = DOMPurify.sanitize(marked.parse(articleContents.value));
        <!--const articleDate = document.getElementById("preview-article-date");-->
    }

    document.getElementById("button-edit-content").addEventListener("click", showContentPage);
    document.getElementById("button-edit-dtp").addEventListener("click", showDTPPage);
    document.getElementById("button-preview").addEventListener("click", showPreviewPage);
</script>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>

</html>
