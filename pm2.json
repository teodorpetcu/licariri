{
    "apps" : [
    {
        "name": "licariri-server",
        "script": "server.js",
        "exec_mode": "cluster",
        "instances": 1,
        "log_type": "raw",
        "out_file": "/var/log/licariri-out.log",
        "error_file": "/var/log/licariri-err.log",
        "combine_logs": true,
        "env": {
            "NODE_ENV": "production",
            "ALLOW_QUERY_ROUTES": "false",
            "ALLOW_ADMIN_ROUTES": "false"
        }
    },
    {
        "name": "licariri-cron",
        "script": "cron.js",
        "exec_mode": "fork",
        "instances": 1,
        "log_type": "raw",
        "out_file": "/var/log/licariri-out.log",
        "error_file": "/var/log/licariri-err.log",
        "combine_logs": true,
        "env": {
            "NODE_ENV": "production"
        }
    }
    ]
}
